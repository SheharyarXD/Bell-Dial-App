<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    android:background="@color/colorWhite">

    <include
        android:id="@+id/toolbar_dialer_frag"
        layout="@layout/toolbar_back_button_layout" />

    <LinearLayout
        android:layout_below="@id/toolbar_dialer_frag"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"
        android:background="@color/colorWhite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="@color/colorE"/>
        <androidx.cardview.widget.CardView
            android:clickable="true"
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorWhite">

            <LinearLayout
                android:clickable="true"
                android:id="@+id/linearNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorWhite"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_4">

                <ImageView
                    android:visibility="gone"
                    android:id="@+id/imgthreeDots"
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_30"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:layout_marginRight="@dimen/dp_5" />

                <EditText
                    android:id="@+id/textViewNumber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/dp_5"
                    android:layout_marginRight="@dimen/dp_5"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/lato_bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text=""
                    android:textIsSelectable="true"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_22" />

                <ImageView
                    android:id="@+id/imageViewRemove"
                    android:layout_width="@dimen/dp_45"
                    android:layout_height="@dimen/dp_45"
                    android:layout_marginRight="@dimen/dp_10"
                    android:padding="@dimen/dp_8"
                    android:src="@drawable/number_erase" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="@color/colorE"/>


    </LinearLayout>
    <LinearLayout
        android:layout_marginBottom="@dimen/dp_60"
        android:layout_alignParentBottom="true"
        android:id="@+id/contentDial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorWhite"

        android:clickable="true"
        android:orientation="vertical"
        android:visibility="visible">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10">

            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dial1"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dial1" />
            <View
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                android:background="@color/colorE"/>
            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dial2"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dial2" />
            <View
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                android:background="@color/colorE"/>
            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dial3"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dial3" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="@color/colorE"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10">

            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dial4"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dial4" />
            <View
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                android:background="@color/colorE"/>
            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dial5"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dial5" />
            <View
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                android:background="@color/colorE"/>
            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dial6"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dial6" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="@color/colorE"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10">

            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dial7"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dial7" />
            <View
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                android:background="@color/colorE"/>

            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dial8"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dial8" />
            <View
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                android:background="@color/colorE"/>
            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dial9"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dial9" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="@color/colorE"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_15"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10">

            <ImageView
                android:scaleType="fitXY"

                android:id="@+id/dialstar"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dialstar" />
            <View
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                android:background="@color/colorE"/>
            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dial0"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dial0" />
            <View
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"
                android:background="@color/colorE"/>
            <ImageView
                android:scaleType="fitXY"
                android:id="@+id/dialhash"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_75"
                android:layout_weight="1"
                android:src="@drawable/dialhase" />
        </LinearLayout>


    </LinearLayout>

    <ImageView
        android:id="@+id/dial"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_60"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/dp_10"
        android:src="@drawable/call_icon" />


</RelativeLayout>