<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:orientation="vertical">

    <include layout="@layout/toolbar_back_button_layout" />

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_10"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewCallType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@null"
            android:fontFamily="@font/lato_regular"
            android:padding="@dimen/dp_5"
            android:singleLine="true"
            android:text="1000"
            android:textColor="@color/colorBlack"
            android:textSize="@dimen/sp_22"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewConnecting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_20"
            android:background="@null"
            android:fontFamily="@font/lato_regular"
            android:singleLine="true"
            android:text="Calling..."
            android:textColor="@color/colorC"
            android:textSize="@dimen/sp_16"
            android:visibility="visible" />

        <!--<Chronometer
            android:id="@+id/current_call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_5"
            android:background="@null"
            android:padding="@dimen/dp_5"
            android:singleLine="true"
            android:text="01:00"
            android:textColor="@color/colorC"
            android:textSize="@dimen/sp_16"
            android:visibility="visible" />-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_15"
            android:layout_marginBottom="@dimen/dp_10"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/linearLayoutCaller1"

                android:layout_width="@dimen/dp_150"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:visibility="visible">


                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageViewUser1"
                    android:layout_width="@dimen/dp_150"
                    android:layout_height="@dimen/dp_130"
                    android:layout_gravity="center"
                    android:padding="@dimen/dp_5"
                    android:src="@drawable/callicon" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textViewCall1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:singleLine="true"
                    android:text="On Call"
                    android:textColor="@color/colorDark"
                    android:textSize="@dimen/sp_14"
                    android:visibility="visible" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textViewCallerNUmber1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dp_5"
                    android:background="@null"
                    android:ellipsize="marquee"
                    android:padding="@dimen/dp_5"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_20"
                    android:visibility="visible" />

                <Chronometer
                    android:id="@+id/current_call_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dp_5"
                    android:background="@null"
                    android:padding="@dimen/dp_5"
                    android:singleLine="true"
                    android:text="01:00"
                    android:textColor="@color/colorC"
                    android:textSize="@dimen/sp_16"
                    android:visibility="visible" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:visibility="gone"
                android:background="#F2F2F2"
                android:id="@+id/imageViewSwapCall"
                android:layout_width="@dimen/dp_50"
                android:layout_height="@dimen/dp_50"
                android:padding="@dimen/dp_5"
                android:src="@drawable/swape_call" />

            <LinearLayout
                android:id="@+id/linearLayoutCaller2"

                android:layout_width="@dimen/dp_150"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:visibility="gone">


                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageViewUser2"
                    android:layout_width="@dimen/dp_150"
                    android:layout_height="@dimen/dp_130"
                    android:layout_gravity="center"
                    android:padding="@dimen/dp_5"
                    android:src="@drawable/callicon" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textViewCall2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/colorDark"
                    android:textSize="@dimen/sp_14"
                    android:visibility="visible" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textViewCallerNUmber2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/dp_5"
                    android:background="@null"
                    android:ellipsize="marquee"
                    android:padding="@dimen/dp_5"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_20"
                    android:visibility="visible" />

            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/dp_5">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewAddCall"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:layout_marginRight="@dimen/dp_10"
                android:padding="@dimen/dp_5"
                android:src="@drawable/addcall" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewMergeCall"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:layout_marginRight="@dimen/dp_10"
                android:padding="@dimen/dp_5"
                android:src="@drawable/merge_call"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewSplitCall"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:layout_marginRight="@dimen/dp_10"
                android:padding="@dimen/dp_5"
                android:src="@drawable/split_call"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewTransferCall"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:layout_marginRight="@dimen/dp_10"
                android:padding="@dimen/dp_5"
                android:src="@drawable/transfer" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewRecordCall"
                android:layout_width="@dimen/dp_100"

                android:layout_height="@dimen/dp_100"
                android:padding="@dimen/dp_5"
                android:src="@drawable/record" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/dp_5">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewMute"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:layout_marginRight="@dimen/dp_10"
                android:padding="@dimen/dp_5"
                android:src="@drawable/mute" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewKeypad"
                android:layout_width="@dimen/dp_100"
                android:layout_height="@dimen/dp_100"
                android:layout_marginRight="@dimen/dp_10"
                android:padding="@dimen/dp_5"
                android:src="@drawable/hold" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageViewSpeaker"
                android:layout_width="@dimen/dp_100"

                android:layout_height="@dimen/dp_100"
                android:padding="@dimen/dp_5"
                android:src="@drawable/speacker" />


        </LinearLayout>

        <LinearLayout
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:gravity="center"
            android:orientation="horizontal">


            <androidx.appcompat.widget.AppCompatImageView
                android:layout_marginLeft="@dimen/dp_80"
                android:id="@+id/imageViewCallHangup"

                android:layout_width="@dimen/dp_90"
                android:layout_gravity="center"
                android:layout_height="@dimen/dp_100"
                android:padding="@dimen/dp_5"
                android:src="@drawable/endcall" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_marginLeft="@dimen/dp_30"
                android:id="@+id/imageViewKeypadNew"
                android:layout_width="@dimen/dp_60"
                android:layout_height="@dimen/dp_70"
                android:padding="@dimen/dp_3"
                android:src="@drawable/keypad_button" />

        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/contentDial"
        android:layout_marginTop="@dimen/dp_100"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorWhite"
        android:clickable="true"
        android:orientation="vertical"
        android:visibility="gone">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10">


            <ImageView
                android:id="@+id/dial1"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dial1" />

            <ImageView
                android:id="@+id/dial2"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dial2" />

            <ImageView
                android:id="@+id/dial3"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dial3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10">

            <ImageView
                android:id="@+id/dial4"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dial4" />

            <ImageView
                android:id="@+id/dial5"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dial5" />

            <ImageView
                android:id="@+id/dial6"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dial6" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10">

            <ImageView
                android:id="@+id/dial7"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dial7" />

            <ImageView
                android:id="@+id/dial8"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dial8" />

            <ImageView
                android:id="@+id/dial9"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dial9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_5"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10">

            <ImageView
                android:id="@+id/dialstar"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dialstar" />

            <ImageView
                android:id="@+id/dial0"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dial0" />

            <ImageView
                android:id="@+id/dialhash"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_80"
                android:layout_weight="1"
                android:src="@drawable/dialhase" />
        </LinearLayout>

    </LinearLayout>
    </LinearLayout>
</ScrollView>
</RelativeLayout>


