<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_marginLeft="@dimen/dp_5"
    android:layout_marginRight="@dimen/dp_5"
    android:layout_height="wrap_content"
    android:background="@color/colorWhite"
    android:orientation="vertical"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/ivUnknownContact"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:riv_corner_radius="@dimen/dp_10"
            android:src="@drawable/userr"
            android:layout_margin="5dp"
            android:visibility="visible"
            />

        <FrameLayout
            android:id="@+id/flContactChars"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/contact_background"
            android:layout_margin="5dp"
            android:visibility="visible"
            >

            <TextView
                android:id="@+id/tvContactChars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BO"
                android:layout_gravity="center"
                android:textColor="#fff"
                android:textSize="14sp"
                android:fontFamily="@font/lato_bold"/>

        </FrameLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/lato_bold"
                android:gravity="start"
                android:maxLines="1"
                android:text="John Deo"
                android:layout_marginEnd="40dp"
                android:layout_marginStart="5dp"
                android:textColor="#0D2753"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/lato_regular"
                android:maxLines="1"
                android:text="1234567aaaaaaaaaaaaaaaaaa892222"
                android:textColor="#B8B8B8"
                android:layout_marginEnd="40dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:textSize="@dimen/sp_12" />


        </LinearLayout>
    </LinearLayout>

</LinearLayout>