<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_10"
        android:gravity="center_horizontal"
        android:layout_centerVertical="true"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Welcome to Belldial"
            android:textColor="@color/colorBlack"
            android:fontFamily="@font/lato_bold"
            android:gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_10"
            android:textSize="16sp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belldial will collect your contact list to make calls on this app."
            android:textColor="@color/dark_grey_color"
            android:fontFamily="@font/lato_medium"
            android:textSize="12sp"
            android:layout_marginTop="@dimen/dp_15"
            android:paddingHorizontal="@dimen/dp_8"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We will also access your images and files to set the ringtone and notify you of incoming calls."
            android:textColor="@color/dark_grey_color"
            android:fontFamily="@font/lato_medium"
            android:textSize="12sp"
            android:layout_marginTop="@dimen/dp_5"
            android:paddingHorizontal="@dimen/dp_8"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thanks for your understanding"
            android:textColor="@color/dark_grey_color"
            android:fontFamily="@font/lato_medium"
            android:textSize="12sp"
            android:layout_marginTop="@dimen/dp_5"
            android:paddingHorizontal="@dimen/dp_10"
            />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAccept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_10"
            android:background="@drawable/rounded_bg"
            android:fontFamily="@font/lato_medium"
            android:gravity="center"
            android:paddingLeft="@dimen/dp_80"
            android:paddingRight="@dimen/dp_80"
            android:text="Accept"
            android:textAllCaps="false"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/sp_16" />
    </LinearLayout>

</RelativeLayout>