<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_5"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rounded_bg_recording"
        android:orientation="horizontal"
        android:padding="@dimen/dp_5">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewConatctName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/dp_2"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/lato_regular"
            android:gravity="start"
            android:maxLines="1"
            android:text="John Deo"
            android:textColor="@color/colorBlack"
            android:textSize="@dimen/sp_14" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_1"
            android:ellipsize="end"
            android:fontFamily="@font/lato_regular"
            android:gravity="start"
            android:maxLines="1"
            android:text="123456789"
            android:textColor="@color/colorD"
            android:textSize="@dimen/sp_14" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageViewDelete"
            android:layout_width="@dimen/dp_35"
            android:layout_height="@dimen/dp_35"
            android:layout_gravity="center"
            android:padding="@dimen/dp_10"
            android:src="@drawable/delete_icon" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSubRecording"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rounded_bg_recording_sub"
        android:orientation="horizontal"
        android:padding="@dimen/dp_5"
        android:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageViewIconPause"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_5"
            android:padding="@dimen/dp_5"
            android:src="@drawable/pause"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageViewIconPlay"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_5"
            android:padding="@dimen/dp_5"
            android:src="@drawable/play_button" />

        <SeekBar
            android:id="@+id/seekbarRecording"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_weight="1"
            android:maxHeight="@dimen/dp_2"
            android:progressDrawable="@drawable/seekbar"
            android:thumb="@drawable/round_button_background_green"
            android:thumbTint="@color/colorGreen" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_3"
            android:layout_marginRight="@dimen/dp_3"
            android:ellipsize="end"
            android:fontFamily="@font/lato_regular"
            android:gravity="start"
            android:maxLines="1"
            android:text="123456789"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/sp_14" />

    </LinearLayout>

</LinearLayout>