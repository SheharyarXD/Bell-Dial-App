<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.activity.HomeActivity">

    <LinearLayout
        android:id="@+id/layoutActiveCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="@color/colorGreen"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/dp_20"
            android:fontFamily="@font/lato_regular"
            android:padding="@dimen/dp_8"
            android:text="Tap to return call"
            android:textAllCaps="false"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/sp_14" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/placeHolder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/tabItemImgSettings"
            android:layout_width="@dimen/dp_25"
            android:layout_height="@dimen/dp_25"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/more" />


    </RelativeLayout>


    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_70"
        android:layout_gravity="center"
        android:background="@color/colorWhite"
        android:orientation="horizontal"
        android:weightSum="4">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tabItemImgRecent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_weight="1"
            android:padding="@dimen/dp_5"
            android:scaleType="centerCrop"
            android:src="@drawable/recent" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tabItemImgDial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:padding="@dimen/dp_5"
            android:scaleType="centerCrop"
            android:src="@drawable/keypad" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tabItemImgContact"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:padding="@dimen/dp_5"
            android:scaleType="centerCrop"
            android:src="@drawable/contact_new" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tabItemImgSms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:padding="@dimen/dp_5"
            android:scaleType="centerCrop"
            android:src="@drawable/sms_unselected"
            android:layout_marginEnd="@dimen/dp_10"
            />


        <!--            <androidx.appcompat.widget.AppCompatImageView-->
        <!--                android:id="@+id/tabItemImgSettings"-->
        <!--                android:layout_width="@dimen/dp_70"-->
        <!--                android:layout_height="@dimen/dp_70"-->
        <!--                android:layout_gravity="center"-->
        <!--                android:scaleType="fitXY"-->
        <!--                android:layout_weight="1"-->
        <!--                android:layout_marginRight="@dimen/dp_10"-->
        <!--                android:padding="@dimen/dp_5"-->
        <!--                android:src="@drawable/setting" />-->

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tabItemImgMeeting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginRight="@dimen/dp_10"
            android:layout_weight="1"
            android:padding="@dimen/dp_5"
            android:scaleType="fitXY"
            android:src="@drawable/video"
            android:visibility="gone"
            />


    </LinearLayout>

</LinearLayout>