<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    >

    <ImageView
        android:id="@+id/emptyImage"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:src="@drawable/no_calls_ic"
        android:contentDescription="@string/app_name" />
    <TextView
        android:id="@+id/textEmptyScreenHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:fontFamily="@font/lato_black"
        android:textColor="@color/colorGN"
        android:layout_marginTop="10dp"
        android:textAllCaps="true"
        android:text="@string/text_no_calls_yet"
        />

    <TextView
        android:id="@+id/textEmptyScreenDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/lato_regular"
        android:gravity="center_horizontal"
        android:textColor="@color/dark_grey_color"
        android:textSize="12sp"
        android:paddingHorizontal="30sp"
        android:text="@string/text_no_calls_yet_description"
        />


</LinearLayout>