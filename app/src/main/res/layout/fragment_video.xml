<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/colorWhite"
    android:layout_height="match_parent">

    <include
        android:id="@+id/toolbarSettings"
        layout="@layout/toolbar_back_title_layout" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbarSettings"
        android:scrollbars="none">

        <LinearLayout
            android:layout_marginRight="@dimen/dp_15"
            android:layout_marginLeft="@dimen/dp_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:orientation="vertical">



            <LinearLayout
                android:layout_margin="@dimen/dp_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@color/colorG"
                android:orientation="horizontal"
                android:padding="@dimen/dp_5">

                <androidx.appcompat.widget.SwitchCompat
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_margin="@dimen/dp_5"

                    android:drawableEnd="@drawable/switch_selector"
                    android:drawablePadding="@dimen/dp_5"
                    android:fontFamily="@font/lato_regular"
                    android:text="Enable Video"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_16"
                    android:thumb="@null" />
            </LinearLayout>
            <LinearLayout
                android:layout_margin="@dimen/dp_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@color/colorG"
                android:orientation="horizontal"
                android:padding="@dimen/dp_5">

                <androidx.appcompat.widget.SwitchCompat
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_margin="@dimen/dp_5"

                    android:drawableEnd="@drawable/switch_selector"
                    android:drawablePadding="@dimen/dp_5"
                    android:fontFamily="@font/lato_regular"
                    android:text="Automatically start"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_16"
                    android:thumb="@null" />
            </LinearLayout>
            <LinearLayout
                android:layout_margin="@dimen/dp_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@color/colorG"
                android:orientation="horizontal"
                android:padding="@dimen/dp_5">

                <androidx.appcompat.widget.SwitchCompat
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_margin="@dimen/dp_5"

                    android:drawableEnd="@drawable/switch_selector"
                    android:drawablePadding="@dimen/dp_5"
                    android:fontFamily="@font/lato_regular"
                    android:text="Automatically accept"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_16"
                    android:thumb="@null" />
            </LinearLayout>
            <LinearLayout
                android:layout_margin="@dimen/dp_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@color/colorG"
                android:orientation="horizontal"
                android:padding="@dimen/dp_5">

                <androidx.appcompat.widget.SwitchCompat
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_margin="@dimen/dp_5"

                    android:drawableEnd="@drawable/switch_selector"
                    android:drawablePadding="@dimen/dp_5"
                    android:fontFamily="@font/lato_regular"
                    android:text="Show self view"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_16"
                    android:thumb="@null" />
            </LinearLayout>

            <LinearLayout
                android:layout_margin="@dimen/dp_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@color/colorG"
                android:orientation="horizontal"
                android:padding="@dimen/dp_5">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/dp_5"
                    android:layout_weight="1"
                    android:fontFamily="@font/lato_regular"
                    android:singleLine="true"
                    android:text="Video preset"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_16" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/dp_5"
                    android:fontFamily="@font/lato_regular"
                    android:singleLine="true"
                    android:background="@null"
                    android:text="default"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_14" />
            </LinearLayout>
            <LinearLayout
                android:layout_margin="@dimen/dp_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@color/colorG"
                android:orientation="horizontal"
                android:padding="@dimen/dp_5">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/dp_5"
                    android:layout_weight="1"
                    android:fontFamily="@font/lato_regular"
                    android:singleLine="true"
                    android:text="Prefereed video size"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_16" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/dp_5"
                    android:fontFamily="@font/lato_regular"
                    android:singleLine="true"
                    android:background="@null"
                    android:text="VGA(640x480)"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_14" />
            </LinearLayout>
            <LinearLayout
                android:layout_margin="@dimen/dp_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@color/colorG"
                android:orientation="horizontal"
                android:padding="@dimen/dp_5">

                <androidx.appcompat.widget.SwitchCompat
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_margin="@dimen/dp_5"

                    android:drawableEnd="@drawable/switch_selector"
                    android:drawablePadding="@dimen/dp_5"
                    android:fontFamily="@font/lato_regular"
                    android:text="VP8"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_16"
                    android:thumb="@null" />
            </LinearLayout>
            <LinearLayout
                android:layout_marginBottom="@dimen/dp_20"
                android:layout_margin="@dimen/dp_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@color/colorG"
                android:orientation="horizontal"
                android:padding="@dimen/dp_5">

                <androidx.appcompat.widget.SwitchCompat
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_margin="@dimen/dp_5"

                    android:drawableEnd="@drawable/switch_selector"
                    android:drawablePadding="@dimen/dp_5"
                    android:fontFamily="@font/lato_regular"
                    android:text="H.264"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/sp_16"
                    android:thumb="@null" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</RelativeLayout>